 127          //len:被发送数据的字数,一个字等于2个字节
 128          void sys_write_vp(u16 addr,u8* buf,u16 len)
 129          {   
 130   1              u8 i;  
 131   1              
 132   1              i = (u8)(addr&0x01);
 133   1              addr >>= 1;
 134   1              ADR_H = 0x00;
 135   1              ADR_M = (u8)(addr>>8);
 136   1              ADR_L = (u8)addr;    
 137   1              ADR_INC = 0x01;
 138   1              RAMMODE = 0x8F;
